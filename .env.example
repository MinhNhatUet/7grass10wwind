# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (endpoint tương thích OpenAI; get_llm() ưu tiên AI_*) ----
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Bảng giá ước tính chi phí cho trang admin "Chi phí AI" (USD / 1 triệu token; chỉnh theo giá thật của nhà cung cấp)
LLM_PRICE_INPUT_PER_1M=0.10
LLM_PRICE_OUTPUT_PER_1M=0.40
USD_TO_VND=26000
# Embedding (RAGAS answer_relevancy — BL-36): provider gemini | openai (openai = dùng endpoint AI_*)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=
# Fallback cũ
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# MVP dùng SQLite (D-20); đổi sang Postgres: postgresql+psycopg://user:password@host:5432/dbname (cần cài driver)
DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
