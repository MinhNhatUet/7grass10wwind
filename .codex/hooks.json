{
  "description": "AI20K Codex AI usage logging hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "log-stop",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
